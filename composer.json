{
    "name": "horde/smtp",
    "description": "SMTP client library",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "mail",
        "client",
        "rfc5321"
    ],
    "time": "2026-04-17",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/exception": "^3",
        "horde/mail": "^3",
        "horde/socket_client": "^3",
        "horde/support": "^3",
        "horde/translation": "^3",
        "horde/util": "^3"
    },
    "require-dev": {},
    "suggest": {
        "horde/imap_client": "^3",
        "horde/secret": "^3",
        "horde/test": "^3"
    },
    "autoload": {
        "psr-0": {
            "Horde_Smtp": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Smtp\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "2.x-dev"
        }
    },
    "minimum-stability": "dev"
}
